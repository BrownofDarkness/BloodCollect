rules_version = '2';

// BloodCollect — justificatifs de vérification des structures.
// NOTE : Cloud Storage exige le plan Blaze (carte enregistrée, usage
// gratuit sous quotas). En attendant, l'upload est désactivé côté app
// (BackendConfig.storageEnabled = false) et le justificatif est optionnel.
// Ce fichier est prêt pour le jour J : publier via la console ou
// `firebase deploy --only storage`.
service firebase.storage {
  match /b/{bucket}/o {
    match /validation_docs/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || firestore.get(
               /databases/(default)/documents/users/$(request.auth.uid)
             ).data.role == 'admin');
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if false;
    }
  }
}
